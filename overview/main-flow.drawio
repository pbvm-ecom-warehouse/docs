        <mxCell id="p7done" value="3. Delivered &amp; order closed (COD: paid on delivery)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="50" y="410" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="p7fail" value="If delivery fails → goods returned, order cancelled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="r1"><mxGeometry x="50" y="510" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="p7e1" value="shipped" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;strokeColor=#6c8ebf;fontColor=#3a5a8c;fontSize=11;" edge="1" parent="r1" source="p7ship" target="p7notif"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p7e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="r1" source="p7ship" target="p7recv"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p7e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="r1" source="p7recv" target="p7done"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p7e4" value="if it fails" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;strokeColor=#b85450;fontColor=#b85450;fontSize=11;" edge="1" parent="r1" source="p7ship" target="p7fail"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
