        <mxCell id="p7lw" value="Warehouse / Carrier" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=40;verticalAlign=top;align=center;fontStyle=1;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="40" y="70" width="280" height="520" as="geometry"/></mxCell>
        <mxCell id="p7lc" value="Customer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=40;verticalAlign=top;align=center;fontStyle=1;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="340" y="70" width="260" height="520" as="geometry"/></mxCell>
        <mxCell id="p7ln" value="Notification" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=40;verticalAlign=top;align=center;fontStyle=1;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="620" y="70" width="240" height="520" as="geometry"/></mxCell>
        <mxCell id="p7ship" value="1. Hand the parcel to the carrier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="r1"><mxGeometry x="50" y="110" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="p7notif" value="Tell the customer: shipped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="r1"><mxGeometry x="630" y="210" width="220" height="60" as="geometry"/></mxCell>
