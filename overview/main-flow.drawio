<mxfile host="app.diagrams.net" type="device">
  <diagram name="Main flow (overview)" id="flow-overview-00">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="r0" />
        <mxCell id="r1" parent="r0" />
        <mxCell id="ovt" value="Main flow — the whole journey, P0 → P7" style="text;html=1;align=left;fontStyle=1;fontSize=17;" vertex="1" parent="r1"><mxGeometry x="40" y="20" width="800" height="30" as="geometry"/></mxCell>
        <mxCell id="ovP0" value="P0 — Receive stock&#10;(warehouse)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="60" y="120" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="ovP1" value="P1 — Browse&#10;(online store)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="320" y="120" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="ovP2" value="P2 — Choose product&#10;(customer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="580" y="120" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="ovP3" value="P3 — Place order&#10;stock is held now" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="840" y="120" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="ovP4" value="P4 — Payment&#10;(online or COD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="840" y="320" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="ovP5" value="P5 — Print cups&#10;(only custom-print)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="580" y="320" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="ovP6" value="P6 — Pick &amp; pack&#10;(warehouse)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="320" y="320" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="ovP7" value="P7 — Delivery&#10;order closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="60" y="320" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="ove1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="r1" source="ovP0" target="ovP1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ove2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="r1" source="ovP1" target="ovP2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ove3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="r1" source="ovP2" target="ovP3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ove4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="r1" source="ovP3" target="ovP4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ove5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="r1" source="ovP4" target="ovP5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ove6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="r1" source="ovP5" target="ovP6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ove7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="r1" source="ovP6" target="ovP7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ovskip" value="normal orders skip P5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;strokeColor=#999999;fontColor=#777777;fontSize=11;" edge="1" parent="r1" source="ovP4" target="ovP6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ovnote" value="Key idea: stock is held at P3 (when the order is placed), before any payment. Custom-print cups go through P5; normal orders skip it." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#cccccc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="r1"><mxGeometry x="60" y="460" width="980" height="50" as="geometry"/></mxCell>
        <mxCell id="ovleg" value="Blue = warehouse  ·  Green = online store  ·  Grey = customer / delivery  ·  Yellow = key step" style="text;html=1;align=left;fontSize=11;fontColor=#555555;" vertex="1" parent="r1"><mxGeometry x="60" y="530" width="980" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="P0 Receive stock" id="flow-p0-receive-stock-01">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="950" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="r0" />
        <mxCell id="r1" parent="r0" />
        <mxCell id="p0t" value="P0 — Receive stock into the warehouse" style="text;html=1;align=left;fontStyle=1;fontSize=16;" vertex="1" parent="r1"><mxGeometry x="40" y="20" width="800" height="30" as="geometry"/></mxCell>
        <mxCell id="p0ls" value="Supplier" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;opacity=40;verticalAlign=top;align=center;fontStyle=1;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="40" y="70" width="220" height="480" as="geometry"/></mxCell>
        <mxCell id="p0lw" value="Warehouse" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=40;verticalAlign=top;align=center;fontStyle=1;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="300" y="70" width="260" height="480" as="geometry"/></mxCell>
        <mxCell id="p0le" value="Online store" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=40;verticalAlign=top;align=center;fontStyle=1;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="600" y="70" width="260" height="480" as="geometry"/></mxCell>
        <mxCell id="p0po" value="1. Order goods from supplier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="r1"><mxGeometry x="320" y="110" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="p0del" value="2. Deliver the goods" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="r1"><mxGeometry x="50" y="210" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="p0recv" value="3. Receive &amp; check the goods" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="r1"><mxGeometry x="320" y="310" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="p0shelf" value="4. Put items on shelves" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="r1"><mxGeometry x="320" y="410" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="p0store" value="5. Product shows as &quot;In stock&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="r1"><mxGeometry x="620" y="410" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="p0e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="r1" source="p0po" target="p0del"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p0e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="r1" source="p0del" target="p0recv"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p0e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="r1" source="p0recv" target="p0shelf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p0e4" value="stock updated" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;strokeColor=#6c8ebf;fontColor=#3a5a8c;fontSize=11;" edge="1" parent="r1" source="p0shelf" target="p0store"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

