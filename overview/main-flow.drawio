        <mxCell id="p4e2" value="email" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;strokeColor=#d79b00;fontColor=#a06800;fontSize=11;" edge="1" parent="r1" source="p4conf" target="p4email"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="r1" source="p4conf" target="p4q"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4e4" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="r1" source="p4q" target="p4print"><mxGeometry relative="1" as="geometry"/></mxCell>
