        <mxCell id="p4e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="r1" source="p4cod" target="p4codr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4e7" value="if unpaid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;strokeColor=#b85450;fontColor=#b85450;fontSize=11;" edge="1" parent="r1" source="p4conf" target="p4to"><mxGeometry relative="1" as="geometry"/></mxCell>
