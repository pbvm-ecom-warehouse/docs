        <mxCell id="p1ls" value="Online store" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=40;verticalAlign=top;align=center;fontStyle=1;fontSize=13;" vertex="1" parent="r1"><mxGeometry x="320" y="70" width="380" height="320" as="geometry"/></mxCell>
        <mxCell id="p1s" value="1. Search or browse products" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="r1"><mxGeometry x="50" y="110" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="p1show" value="2. Show only products that are in stock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="r1"><mxGeometry x="340" y="110" width="340" height="60" as="geometry"/></mxCell>
        <mxCell id="p1list" value="3. See the product list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="r1"><mxGeometry x="50" y="220" width="240" height="60" as="geometry"/></mxCell>
